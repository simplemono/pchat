#!/usr/bin/env bb
;; bin/tick   the alarm of the jobs: ticks pchat's clock and stays until
;; the runs it started are done. On a sprite, the machine's automation
;; `pchat-wake` runs this at the next due minute of the jobs (see
;; `pchat.wake`): the sprite wakes, pchat starts as its service, this
;; waits for it to answer, tells it to tick (the due jobs run, the alarm
;; is set to the next minute), and keeps the exec open while a run is
;; going, because the automation puts a sprite it woke back to sleep
;; once its exec ends (and a sprite with its auto idle on sleeps thirty
;; seconds after its last open exec anyway). Talks to pchat over its
;; local nREPL (`.nrepl-port` in the
;; workspace); nothing to configure. By hand: `bin/tick` from any chat
;; folder.
(require '[babashka.classpath :refer [add-classpath]]
         '[babashka.fs :as fs]
         '[clojure.string :as str])

(def workspace
  ;; <workspace>/bin/tick, also through the `bin` link of a chat
  (str (fs/parent (fs/parent (fs/real-path *file*)))))

(add-classpath (str (fs/path workspace ".pchat" "lib")))
(require '[pchat.nrepl :as nrepl])

(def wait-for-pchat-s
  120)

(def wait-for-runs-s
  "Longer than the longest run cap (`pchat.jobs/default-caps`, or the
  job's own) plus pchat's start: the automation's own timeout ends an
  exec that runs longer anyway."
  (* 45 60))

(defn port
  []
  (let [file (fs/path workspace ".nrepl-port")]
    (when (fs/exists? file)
      (parse-long (str/trim (slurp (str file)))))))

(defn eval!
  "The value of `code` in pchat as a string, nil when pchat does not
  answer or the code threw."
  [code]
  (try
    (when-let [p (port)]
      (let [{:keys [value ex]} (nrepl/eval! p code)]
        (when-not ex value)))
    (catch Exception _
      nil)))

(defn wait-for-pchat!
  []
  (loop [n 0]
    (cond
      (eval! "1") true
      (< n wait-for-pchat-s) (do (Thread/sleep 1000) (recur (inc n)))
      :else false)))

(when-not (wait-for-pchat!)
  (println "pchat does not answer on its nREPL; nothing ticked.")
  (System/exit 1))

(println (str "tick: " (eval! "(pchat.main/tick!)")))

(let [started (System/currentTimeMillis)]
  (loop []
    (let [running (some-> (eval! "(pchat.main/runs-active)") parse-long)]
      (when (and running (pos? running)
                 (< (- (System/currentTimeMillis) started) (* 1000 wait-for-runs-s)))
        (Thread/sleep 10000)
        (recur)))))

(println "done")
