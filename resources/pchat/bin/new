#!/usr/bin/env bb
;; bin/new <name> [motion|hyperframes]   a new artifact project: a motion
;; design (fnmotion, the default) or a HyperFrames composition.
(require '[babashka.fs :as fs]
         '[clojure.string :as str])

(let [[name kind] *command-line-args*
      kind (or kind "motion")
      template (fs/path ".pchat" "template" kind)
      target (fs/path "artifacts" name)]
  (cond
    (or (str/blank? name) (not (re-matches #"[a-z0-9][a-z0-9-]*" name)))
    (do (println "bin/new <name> [motion|hyperframes]: lowercase letters, digits and dashes.")
        (System/exit 1))

    (not (fs/directory? template))
    (do (println (str "No template " kind ": motion (the default) or hyperframes."))
        (System/exit 1))

    (fs/exists? target)
    (do (println (str "artifacts/" name " exists already."))
        (System/exit 1))

    :else
    (do (fs/copy-tree template target)
        (println (if (= "hyperframes" kind)
                   (str "artifacts/" name "/ is ready: composition/index.html is the design, README.md says how it works.")
                   (str "artifacts/" name "/ is ready: src/artifact/main.clj has design-view and controls, design.edn the data."))))))
