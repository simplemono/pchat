;; bb start    the chat at http://localhost:8080 (pi on the PATH, OPENROUTER_API_KEY set)
;; bb build    the browser bundle (needs a JVM)
;; bb test     the tests
;; bb smoke    one real agent run: a card with music and its video (costs cents)
;; bb jar      the app as one uberjar for babashka, target/pchat.jar
;; bb deploy <sprite>   the jar as a service on a sprites.dev sprite
;;
;; This file is EDN: no #(...) and no #"..." in here.
{:paths ["src" "resources" "test"]
 :deps {io.github.simplemono/rframes$server
        {:git/url "https://github.com/simplemono/rframes.git"
         :git/sha "986826428665e0ee6d9de6affeb1dcb266b670c1"
         :deps/root "server"}
        io.github.simplemono/rchat$server
        {:git/url "https://github.com/simplemono/rchat.git"
         :git/sha "5ec7828519924de4eeae1c2b61838ab8420f49f0"
         :deps/root "server"}
        ;; The texts of the page per language, see pchat.i18n.
        no.cjohansen/m1p {:mvn/version "2026.07.1"}}
 :tasks
 {:requires ([babashka.fs :as fs]
             [babashka.process :refer [shell]]
             [clojure.string :as str])

  :init
  (do
    (def bundle "resources/public/js/main.js")

    (defn mtime
      [path]
      (fs/file-time->millis (fs/last-modified-time path)))

    (defn stale?
      []
      (or (not (fs/exists? bundle))
          (< (mtime bundle)
             (->> (concat (fs/glob "src" "**.cljs") ["deps.edn" "shadow-cljs.edn"])
                  (filter fs/exists?)
                  (map mtime)
                  (reduce max 0)))))

    (defn env-file
      []
      (into {}
            (for [file [".env" ".env.local"]
                  :when (fs/exists? file)
                  line (str/split-lines (slurp file))
                  :let [line (str/trim (str/replace line (re-pattern "^export\\s+") ""))]
                  :when (and (seq line) (not (str/starts-with? line "#")) (str/includes? line "="))
                  :let [[k v] (str/split line (re-pattern "=") 2)]]
              [(str/trim k) (str/replace (str/trim v) (re-pattern "^[\"']|[\"']$") "")]))))

  test
  {:doc "Runs the tests."
   :task (shell "bb" "tests.clj")}

  build
  {:doc "Compiles the browser bundle (needs a JVM and the clojure CLI)."
   :task (shell "clojure -M -m shadow.cljs.devtools.cli release browser")}

  start
  {:doc "The chat at http://localhost:8080. Compiles the bundle first when missing or stale, reads .env."
   :task (do
           (when (stale?)
             (run 'build))
           (shell {:extra-env (env-file)} "bb" "-m" "pchat.main"))}

  smoke
  {:doc "bb smoke [--keep]: one real run of the agent on a free port, a card with music and its video; a few cents, a few minutes. Reads .env."
   :task (shell {:extra-env (env-file) :continue true} "bb" "smoke.clj" (or (first *command-line-args*) ""))}

  jar
  {:doc "The app and all its dependencies as target/pchat.jar, run with `bb target/pchat.jar`. Compiles the bundle first when stale. The version goes in as resources/pchat/version.txt: PCHAT_VERSION, else the release tag (GITHUB_REF_NAME), else git describe."
   :task (do
           (when (stale?)
             (run 'build))
           (spit "resources/pchat/version.txt"
                 (str (or (System/getenv "PCHAT_VERSION")
                          (some-> (System/getenv "GITHUB_REF_NAME") (str/replace (re-pattern "^v") ""))
                          (-> (shell {:out :string :continue true} "git" "describe" "--tags" "--always" "--dirty")
                              :out
                              str/trim
                              (str/replace (re-pattern "^v") "")))
                      "\n"))
           (fs/create-dirs "target")
           (shell "bb" "uberjar" "target/pchat.jar" "-m" "pchat.main")
           (println (str "target/pchat.jar, " (quot (fs/size "target/pchat.jar") 1024) " kB")))}

  deploy
  {:doc "bb deploy <sprite>: the jar as the service `pchat` behind the sprite's URL. First time: installs babashka, pi, ffmpeg, Google Chrome, fonts and HyperFrames, pushes deploy/start.sh and the local .env plus a PCHAT_TOKEN (never over an .env on the sprite), warms the dependency cache of the artifact projects. Every time: the last commit of the PCHAT_AGENTITOS checkout as the sprite's skills in ~/agentitos (npm ci where a skill's package-lock.json changed), named in the sprite's .env."
   :task (let [sprite (or (first *command-line-args*)
                          (do (println "Which sprite? bb deploy <name>")
                              (System/exit 1)))
                remote (fn [script]
                         (str/trim (:out (shell {:out :string} "sprite" "exec" "-s" sprite "--" "bash" "-c" script))))
                push (fn [local remote-path]
                       (shell "sprite" "file" "push" "-s" sprite local remote-path))]
            (run 'jar)
            (println "Preparing" sprite)
            (remote "mkdir -p ~/pchat/workspace ~/.local/bin; if [ ! -x ~/.local/bin/bb ]; then cd ~ && curl -sLO https://raw.githubusercontent.com/babashka/babashka/master/install && chmod +x install && ./install --dir ~/.local/bin >/dev/null && rm -f install; fi; ~/.local/bin/bb --version; if [ \"$(~/.local/bin/pi --version 2>/dev/null)\" != \"1.1.0\" ]; then npm install -g --prefix ~/.local @earendil-works/pi-coding-agent@1.1.0 >/dev/null 2>&1; fi; echo pi $(~/.local/bin/pi --version)")
            (println (remote "if ! command -v ffmpeg >/dev/null; then sudo apt-get update -qq >/dev/null 2>&1; sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq ffmpeg fonts-noto-core fonts-noto-color-emoji fonts-liberation >/dev/null 2>&1; fi; if ! command -v google-chrome >/dev/null; then cd /tmp && curl -sLO https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb && sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq ./google-chrome-stable_current_amd64.deb >/dev/null 2>&1; rm -f /tmp/google-chrome-stable_current_amd64.deb; fi; if [ ! -x ~/.local/bin/hyperframes ]; then PUPPETEER_SKIP_DOWNLOAD=1 npm install -g --prefix ~/.local hyperframes@0.8.146 @hyperframes/player@0.8.146 >/dev/null 2>&1; fi; echo \"videos: $(google-chrome --version 2>/dev/null || echo no Chrome), $(ffmpeg -version 2>/dev/null | head -1 | cut -d' ' -f1-3 || echo no ffmpeg), hyperframes $(~/.local/bin/hyperframes --version 2>/dev/null || echo missing)\""))
            (push "deploy/start.sh" "/home/sprite/pchat/start.sh")
            (remote "chmod 700 ~/pchat/start.sh")
            (cond
              (= "yes" (remote "test -f ~/pchat/.env && echo yes || echo no"))
              (println "The sprite has its .env, kept.")

              (fs/exists? ".env")
              (do (push ".env" "/home/sprite/pchat/.env")
                  (remote "chmod 600 ~/pchat/.env; grep -q '^PCHAT_TOKEN=' ~/pchat/.env || echo PCHAT_TOKEN=$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \\n') >> ~/pchat/.env")
                  (println "Pushed the local .env and added a PCHAT_TOKEN."))

              :else
              (println "No .env here or on the sprite: the agent starts without an API key. Put OPENROUTER_API_KEY=... into /home/sprite/pchat/.env on the sprite."))
            ;; the skills: the last commit of the local agentitos checkout, unpacked to
            ;; ~/agentitos (the sprite needs no access to GitHub); node_modules are kept
            ;; while a skill's package-lock.json is unchanged, else npm ci. The sprite's
            ;; .env names the folder (start.sh stays as Storrito writes it).
            (if-let [agentitos (not-empty (or (get (env-file) "PCHAT_AGENTITOS") (System/getenv "PCHAT_AGENTITOS")))]
              (let [rev (str/trim (:out (shell {:out :string :dir agentitos} "git" "rev-parse" "--short" "HEAD")))
                    archive (str (fs/absolutize "target/agentitos.tar.gz"))]
                (when (seq (str/trim (:out (shell {:out :string :dir agentitos} "git" "status" "--porcelain"))))
                  (println "agentitos has uncommitted changes: the sprite gets the last commit," rev))
                (fs/create-dirs "target")
                (shell {:dir agentitos} "git" "archive" "--format=tar.gz" "-o" archive "HEAD")
                (push archive "/home/sprite/agentitos.tar.gz")
                (println (remote (str "export PATH=/home/sprite/.local/bin:$PATH; cd ~; rm -rf agentitos.new; mkdir agentitos.new; tar xzf agentitos.tar.gz -C agentitos.new; rm agentitos.tar.gz; "
                                      "for d in agentitos.new/*/; do n=$(basename $d); [ -f $d/package-lock.json ] || continue; "
                                      "if cmp -s $d/package-lock.json agentitos/$n/package-lock.json && [ -d agentitos/$n/node_modules ]; then mv agentitos/$n/node_modules $d/; "
                                      "else (cd $d && npm ci --no-audit --no-fund >/dev/null 2>&1) || echo \"npm ci failed in $n\"; fi; done; "
                                      "rm -rf agentitos; mv agentitos.new agentitos; "
                                      "f=pchat/.env; touch $f; { grep -v '^PCHAT_AGENTITOS=' $f; echo PCHAT_AGENTITOS=/home/sprite/agentitos; } > $f.new; mv $f.new $f; chmod 600 $f; "
                                      "echo \"skills " rev ": $(ls -d agentitos/*/ | xargs -n1 basename | tr '\\n' ' ')\""))))
              (println "No PCHAT_AGENTITOS here: the sprite gets no skills, every chat is free."))
            (push "target/pchat.jar" "/home/sprite/pchat/pchat.jar")
            (if (str/includes? (remote "sprite-env services list") "\"name\":\"pchat\"")
              (do (remote "sprite-env services restart pchat")
                  (println "Restarted the service pchat."))
              (do (remote "sprite-env services create pchat --cmd /home/sprite/pchat/start.sh --dir /home/sprite/pchat --http-port 8080 --no-stream")
                  (println "Created the service pchat.")))
            (println (remote "sleep 3; curl -s -o /dev/null -w 'The page answers %{http_code} on the sprite. ' http://127.0.0.1:8080/; tail -1 /.sprite/logs/services/pchat.log"))
            (println "Warming the dependency cache of the artifact projects (first time takes a minute).")
            (println (remote "export PATH=/home/sprite/.local/bin:/.sprite/bin:$PATH; cd ~/pchat/workspace/.pchat/template/motion && bb -e '(println \"The artifact projects are ready.\")' 2>&1 | tail -1"))
            (let [token (remote "grep '^PCHAT_TOKEN=' ~/pchat/.env | cut -d= -f2")
                  url (->> (str/split-lines (:out (shell {:out :string} "sprite" "info" "-s" sprite)))
                           (keep (fn [line] (second (re-find (re-pattern "^URL:\\s+(\\S+)") line))))
                           (first))]
              (println (str "The link: " url "/?token=" token))))}}}
